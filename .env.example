# API Authentication (Required)
API_KEY=your_secure_random_api_key_here

# MongoDB Configuration (Required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=custom_music_db

# Telegram Cache Configuration (Required)
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE
TELEGRAM_CACHE_CHANNEL_ID=-100XXXXXXXXXX
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# YouTube Cookies (Optional - path to a cookies.txt file)
YT_COOKIES_FILE=

# Application Limits (Optional)
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT=300
TEMP_DIR=/tmp/custom_music_cache
