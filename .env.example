# API Authentication (Required)
API_KEY=your_secure_api_key_here

# MongoDB Configuration (Required)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=custom_music_db

# Telegram Cache Configuration (Required)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CACHE_CHANNEL_ID=-1000000000000
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here


# YouTube Cookies (Optional)
# Remote Netscape cookies URL(s), separated by spaces
COOKIES_URL=
# If COOKIES_URL is empty, the application automatically checks:
# api/cookies/cookies.txt

# Application Limits (Optional)
MAX_FILE_SIZE_MB=50
DOWNLOAD_TIMEOUT=300
TEMP_DIR=/tmp/custom_music_cache
